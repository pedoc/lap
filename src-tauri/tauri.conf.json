{
  "productName": "Lap",
  "version": "0.4.6",
  "identifier": "com.julyx10.lap",
  "build": {
    "beforeBuildCommand": "node ../scripts/prepare-native-runtime.mjs && pnpm --dir ../src-vite build",
    "beforeDevCommand": "node ../scripts/prepare-native-runtime.mjs && pnpm --dir ../src-vite dev",
    "devUrl": "http://localhost:3580",
    "frontendDist": "../src-vite/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURES/**",
          "$VIDEOS/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPCACHE/**",
          "/Volumes/**",
          "/media/**",
          "/mnt/**",
          "/run/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Graphics and Design",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pedoc/lap/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNTYzMUI2RDA3NEU0NkQKUldSdDVIVFF0akZXWWJ6TkNZbjhsZVQ2THhiNWJ4K2hJeis4VEpCS2t4S3B0YXFlUlBSTm1NL2EK"
    }
  }
}

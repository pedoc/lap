  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
